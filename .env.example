APP_NAME="Nando's Art"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# Adónde llegan los mensajes del formulario de contacto (vacío = el email de resources/contenido/paginas.php)
CONTACTO_EMAIL=

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# La web no usa base de datos: la sesión (solo para el formulario) y la caché van en ficheros de storage/
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción (HTTPS): true, para que la cookie de sesión no viaje nunca sin cifrar
SESSION_SECURE_COOKIE=false

# Si la web va detrás de Cloudflare, un balanceador o un proxy: sus IPs separadas por comas, o * para confiar en todos.
# Sin esto, Laravel cree que la petición llega por http: las URLs salen con http y no se envía HSTS
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo del formulario de contacto. Con MAIL_MAILER=log los mensajes no se envían: se escriben en storage/logs.
# En el servidor: MAIL_MAILER=smtp con los datos SMTP de tu proveedor de correo
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Pon un email real de tu dominio: con example.com los correos acaban en spam
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
