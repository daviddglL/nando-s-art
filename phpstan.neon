includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
    # Seeder::$command puede ser null aunque su PHPDoc diga lo contrario (seeders lanzados fuera de artisan)
    treatPhpDocTypesAsCertain: false
